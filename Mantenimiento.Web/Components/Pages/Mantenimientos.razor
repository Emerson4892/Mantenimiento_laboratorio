@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@page "/mantenimientos"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using Mantenimiento.Application.DTOs

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Mantenimientos | Mantenimiento</PageTitle>

<div class="container-fluid py-3">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-semibold mb-1">
                Gestión de mantenimientos
            </h2>

            <p class="text-muted mb-0">
                Asignación de técnicos y finalización de reparaciones
            </p>
        </div>

        <button type="button"
                class="btn btn-outline-secondary"
                disabled="@(cargandoFallas || cargandoMantenimientos)"
                @onclick="ActualizarListasAsync">

            <i class="bi bi-arrow-clockwise me-2"></i>
            Actualizar listas
        </button>

    </div>

    <div class="row g-4">

        <!-- ===================================
             WF03 - ASIGNAR MANTENIMIENTO
             =================================== -->

        <div class="col-12 col-xl-6">

            <div class="card border h-100">

                <div class="card-header bg-white py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-person-gear me-2"></i>
                        Asignar mantenimiento
                    </h5>
                </div>

                <div class="card-body p-4">

                    @if (!string.IsNullOrWhiteSpace(mensajeAsignacion))
                    {
                        <div class="alert @(errorAsignacion ? "alert-danger" : "alert-success")"
                             role="alert">
                            @mensajeAsignacion
                        </div>
                    }

                    <EditForm @key="asignacion"
                              Model="@asignacion"
                              OnValidSubmit="AsignarAsync"
                              FormName="asignar-mantenimiento">

                        <DataAnnotationsValidator />

                        <!-- FALLA PENDIENTE -->
                        <div class="mb-3">

                            <label class="form-label">
                                Falla pendiente *
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="asignacion.IdFalla"
                                         disabled="@cargandoFallas">

                                <option value="0">
                                    -- Seleccione una falla --
                                </option>

                                @foreach (var falla in fallasPendientes)
                                {
                                    <option value="@falla.IdFalla">
                                        @falla.IdFalla -
                                        @falla.NombreEquipo -
                                        @falla.Descripcion
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => asignacion.IdFalla)"
                                               class="text-danger small" />

                            @if (cargandoFallas)
                            {
                                <div class="form-text">
                                    Cargando fallas pendientes...
                                </div>
                            }
                            else
                            {
                                <div class="form-text">
                                    @fallasPendientes.Count fallas disponibles.
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(errorFallas))
                            {
                                <div class="text-danger small mt-1">
                                    @errorFallas
                                </div>
                            }

                        </div>

                        <!-- TÉCNICO -->
                        <div class="mb-3">

                            <label class="form-label">
                                Técnico responsable *
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="asignacion.Tecnico"
                                       maxlength="150"
                                       placeholder="Nombre del técnico" />

                            <ValidationMessage For="@(() => asignacion.Tecnico)"
                                               class="text-danger small" />

                        </div>

                        <!-- OBSERVACIONES -->
                        <div class="mb-3">

                            <label class="form-label">
                                Observaciones
                            </label>

                            <InputTextArea class="form-control"
                                           @bind-Value="asignacion.Observacion"
                                           rows="4"
                                           placeholder="Indicaciones para el mantenimiento..." />

                        </div>

                        <!-- BOTONES -->
                        <div class="border-top mt-4 pt-3
                            d-flex justify-content-end gap-2">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@enviandoAsignacion"
                                    @onclick="LimpiarAsignacion">
                                Limpiar
                            </button>

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@(enviandoAsignacion || cargandoFallas || fallasPendientes.Count == 0)">

                                @if (enviandoAsignacion)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Asignando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-person-check me-2"></i>
                                    <span>Asignar técnico</span>
                                }

                            </button>

                        </div>

                    </EditForm>

                </div>
            </div>

        </div>

        <!-- ===================================
             WF04 - FINALIZAR MANTENIMIENTO
             =================================== -->

        <div class="col-12 col-xl-6">

            <div class="card border h-100">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-check2-square me-2"></i>
                        Finalizar mantenimiento
                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (!string.IsNullOrWhiteSpace(mensajeFinalizacion))
                    {
                        <div class="alert @(errorFinalizacion ? "alert-danger" : "alert-success")"
                             role="alert">
                            @mensajeFinalizacion
                        </div>
                    }

                    <EditForm @key="finalizacion"
                              Model="@finalizacion"
                              OnValidSubmit="FinalizarAsync"
                              FormName="finalizar-mantenimiento">

                        <DataAnnotationsValidator />

                        <!-- MANTENIMIENTO ASIGNADO -->
                        <div class="mb-3">

                            <label class="form-label">
                                Mantenimiento asignado *
                            </label>

                            <InputSelect class="form-select"
                                         @bind-Value="finalizacion.IdMantenimiento"
                                         disabled="@cargandoMantenimientos">

                                <option value="0">
                                    -- Seleccione un mantenimiento --
                                </option>

                                @foreach (var mantenimiento in mantenimientosAsignados)
                                {
                                    <option value="@mantenimiento.IdMantenimiento">
                                        @mantenimiento.IdMantenimiento -
                                        @mantenimiento.NombreEquipo -
                                        @mantenimiento.Tecnico
                                    </option>
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => finalizacion.IdMantenimiento)"
                                               class="text-danger small" />

                            @if (cargandoMantenimientos)
                            {
                                <div class="form-text">
                                    Cargando mantenimientos...
                                </div>
                            }
                            else
                            {
                                <div class="form-text">
                                    @mantenimientosAsignados.Count mantenimientos asignados.
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(errorMantenimientos))
                            {
                                <div class="text-danger small mt-1">
                                    @errorMantenimientos
                                </div>
                            }

                        </div>

                        <!-- SOLUCIÓN -->
                        <div class="mb-3">

                            <label class="form-label">
                                Solución realizada *
                            </label>

                            <InputTextArea class="form-control"
                                           @bind-Value="finalizacion.Solucion"
                                           rows="4"
                                           placeholder="Describa el trabajo realizado..." />

                            <ValidationMessage For="@(() => finalizacion.Solucion)"
                                               class="text-danger small" />

                        </div>

                        <!-- BOTONES -->
                        <div class="border-top mt-4 pt-3
                            d-flex justify-content-end gap-2">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@enviandoFinalizacion"
                                    @onclick="LimpiarFinalizacion">
                                Limpiar
                            </button>

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@(enviandoFinalizacion || cargandoMantenimientos || mantenimientosAsignados.Count == 0)">

                                @if (enviandoFinalizacion)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Finalizando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>Finalizar mantenimiento</span>
                                }

                            </button>

                        </div>

                    </EditForm>

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    // ==========================================
    // 1. MODELOS DE FORMULARIOS
    // ==========================================

    private AsignarMantenimientoRequest asignacion = new();

    private FinalizarMantenimientoRequest finalizacion = new();


    // ==========================================
    // 2. LISTAS DE CONSULTA
    // ==========================================

    private List<FallaPendienteDto> fallasPendientes = new();

    private List<MantenimientoAsignadoDto> mantenimientosAsignados = new();


    // ==========================================
    // 3. ESTADOS
    // ==========================================

    private bool cargandoFallas;
    private bool cargandoMantenimientos;

    private bool enviandoAsignacion;
    private bool enviandoFinalizacion;

    private bool errorAsignacion;
    private bool errorFinalizacion;

    private string? mensajeAsignacion;
    private string? mensajeFinalizacion;

    private string? errorFallas;
    private string? errorMantenimientos;


    // ==========================================
    // 4. CARGAR AL ABRIR LA PÁGINA
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        await ActualizarListasAsync();
    }


    // ==========================================
    // 5. ACTUALIZAR LAS DOS LISTAS
    // ==========================================

    private async Task ActualizarListasAsync()
    {
        await Task.WhenAll(
            CargarFallasAsync(),
            CargarMantenimientosAsync()
        );
    }


    // ==========================================
    // 6. OBTENER FALLAS PENDIENTES
    // ==========================================

    private async Task CargarFallasAsync()
    {
        if (cargandoFallas)
            return;

        cargandoFallas = true;
        errorFallas = null;

        try
        {
            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            var resultado = await cliente.GetFromJsonAsync<
                List<FallaPendienteDto>
            >("api/fallas/pendientes");

            fallasPendientes = resultado ?? new();

            if (!fallasPendientes.Any(
                f => f.IdFalla == asignacion.IdFalla))
            {
                asignacion.IdFalla = 0;
            }
        }
        catch (HttpRequestException)
        {
            errorFallas = "No se pudieron consultar las fallas.";
        }
        catch (TaskCanceledException)
        {
            errorFallas = "La consulta de fallas agotó el tiempo de espera.";
        }
        catch (JsonException)
        {
            errorFallas = "La respuesta de fallas no es válida.";
        }
        finally
        {
            cargandoFallas = false;
        }
    }


    // ==========================================
    // 7. OBTENER MANTENIMIENTOS ASIGNADOS
    // ==========================================

    private async Task CargarMantenimientosAsync()
    {
        if (cargandoMantenimientos)
            return;

        cargandoMantenimientos = true;
        errorMantenimientos = null;

        try
        {
            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            var resultado = await cliente.GetFromJsonAsync<
                List<MantenimientoAsignadoDto>
            >("api/mantenimientos/asignados");

            mantenimientosAsignados = resultado ?? new();

            if (!mantenimientosAsignados.Any(
                m => m.IdMantenimiento == finalizacion.IdMantenimiento))
            {
                finalizacion.IdMantenimiento = 0;
            }
        }
        catch (HttpRequestException)
        {
            errorMantenimientos =
                "No se pudieron consultar los mantenimientos.";
        }
        catch (TaskCanceledException)
        {
            errorMantenimientos =
                "La consulta de mantenimientos agotó el tiempo de espera.";
        }
        catch (JsonException)
        {
            errorMantenimientos =
                "La respuesta de mantenimientos no es válida.";
        }
        finally
        {
            cargandoMantenimientos = false;
        }
    }


    // ==========================================
    // 8. ASIGNAR MANTENIMIENTO - WF03
    // ==========================================

    private async Task AsignarAsync()
    {
        if (enviandoAsignacion)
            return;

        enviandoAsignacion = true;
        errorAsignacion = false;
        mensajeAsignacion = null;

        try
        {
            int idFalla = asignacion.IdFalla;

            if (!fallasPendientes.Any(
                f => f.IdFalla == idFalla))
            {
                errorAsignacion = true;
                mensajeAsignacion =
                    "Seleccione una falla pendiente válida.";
                return;
            }

            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            using var respuesta = await cliente.PostAsJsonAsync(
                "api/mantenimientos/asignar",
                asignacion
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                errorAsignacion = true;
                mensajeAsignacion =
                    $"No se pudo confirmar la asignación.s {(int)respuesta.StatusCode}. Revise el estado antes de reintentar.";
                return;
            }

            using var documento = JsonDocument.Parse(
                await respuesta.Content.ReadAsStringAsync()
            );

            if (!ConfirmacionPositiva(documento.RootElement))
            {
                errorAsignacion = true;
                mensajeAsignacion =
                    "No se confirmó la asignación. Consulte PostgreSQL antes de reintentar.";
                return;
            }

            mensajeAsignacion =
                $"Se procesó la asignación de la falla {idFalla}.";

            asignacion = new();

            await ActualizarListasAsync();
        }
        catch (HttpRequestException)
        {
            errorAsignacion = true;
            mensajeAsignacion =
                "Error de conexión. Verifique la asignación antes de reintentar.";
        }
        catch (TaskCanceledException)
        {
            errorAsignacion = true;
            mensajeAsignacion =
                "Tiempo de espera agotado. Verifique el Estado antes de repetir la operación.";
        }
        catch (JsonException)
        {
            errorAsignacion = true;
            mensajeAsignacion = "La respuesta inválida.";
        }
        finally
        {
            enviandoAsignacion = false;
        }
    }


    // ==========================================
    // 9. FINALIZAR MANTENIMIENTO - WF04
    // ==========================================

    private async Task FinalizarAsync()
    {
        if (enviandoFinalizacion)
            return;

        enviandoFinalizacion = true;
        errorFinalizacion = false;
        mensajeFinalizacion = null;

        try
        {
            int idMantenimiento = finalizacion.IdMantenimiento;

            if (!mantenimientosAsignados.Any(
                m => m.IdMantenimiento == idMantenimiento))
            {
                errorFinalizacion = true;
                mensajeFinalizacion =
                    "Seleccione un mantenimiento asignado válido.";
                return;
            }

            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            using var respuesta = await cliente.PostAsJsonAsync(
                "api/mantenimientos/finalizar",
                finalizacion
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                errorFinalizacion = true;
                mensajeFinalizacion =
                    $"No se pudo confirmar la finalización. {(int)respuesta.StatusCode}. Verifique PostgreSQL antes de repetir.";
                return;
            }

            using var documento = JsonDocument.Parse(
                await respuesta.Content.ReadAsStringAsync()
            );

            if (!ConfirmacionPositiva(documento.RootElement))
            {
                errorFinalizacion = true;
                mensajeFinalizacion =
                    "No se confirmó la finalización. Revise el estado antes de repetir.";
                return;
            }

            mensajeFinalizacion =
                $"Se confirmó la solicitud de finalización del mantenimiento {idMantenimiento}.";

            finalizacion = new();

            await ActualizarListasAsync();
        }
        catch (HttpRequestException)
        {
            errorFinalizacion = true;
            mensajeFinalizacion =
                "Error de conexión. Verifique el estado del mantenimiento.";
        }
        catch (TaskCanceledException)
        {
            errorFinalizacion = true;
            mensajeFinalizacion =
                "Tiempo de espera agotado. Compruebe el estado antes de reintentar.";
        }
        catch (JsonException)
        {
            errorFinalizacion = true;
            mensajeFinalizacion =
                "La respuesta inválida.";
        }
        finally
        {
            enviandoFinalizacion = false;
        }
    }


    // ==========================================
    // 10. VALIDAR CONFIRMACIÓN DE LA API
    // ==========================================

    private static bool ConfirmacionPositiva(JsonElement raiz)
    {
        return raiz.ValueKind == JsonValueKind.Object &&
               raiz.TryGetProperty("ok", out var ok) &&
               ok.ValueKind == JsonValueKind.True;
    }


    // ==========================================
    // 11. LIMPIAR FORMULARIOS
    // ==========================================

    private void LimpiarAsignacion()
    {
        asignacion = new();
        mensajeAsignacion = null;
        errorAsignacion = false;
    }

    private void LimpiarFinalizacion()
    {
        finalizacion = new();
        mensajeFinalizacion = null;
        errorFinalizacion = false;
    }
}
