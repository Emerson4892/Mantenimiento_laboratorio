@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@page "/equipos"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using Mantenimiento.Application.DTOs

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Equipos | Mantenimiento</PageTitle>

<div class="container-fluid py-3">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2 class="fw-semibold mb-1">
            Gestión de equipos
        </h2>

        <p class="text-muted mb-0">
            Registro de equipos de laboratorio
        </p>
    </div>

    <!-- FORMULARIO -->
    <div class="card border">
        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-pc-display me-2"></i>
                Registrar equipo
            </h5>

        </div>

        <div class="card-body p-4">

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(hayError ? "alert-danger" : "alert-info")"
                     role="alert">

                    @mensaje

                </div>
            }

            <EditForm Model="@modelo"
                      OnValidSubmit="RegistrarAsync"
                      FormName="registro-equipo">

                <DataAnnotationsValidator />

              

                <div class="row g-3">

                    <!-- CÓDIGO -->
                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Código del equipo *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Codigo"
                                   maxlength="30"
                                   placeholder="Ej. LAB-001" />

                        <ValidationMessage For="@(() => modelo.Codigo)"
                                           class="text-danger small" />
                    </div>

                    <!-- NOMBRE -->
                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Nombre del equipo *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Nombre"
                                   maxlength="100"
                                   placeholder="Ej. Microscopio digital" />

                        <ValidationMessage For="@(() => modelo.Nombre)"
                                           class="text-danger small" />
                    </div>

                    <!-- TIPO -->
                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Tipo de equipo *
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Tipo"
                                   maxlength="50"
                                   placeholder="Ej. Microscopio" />

                        <ValidationMessage For="@(() => modelo.Tipo)"
                                           class="text-danger small" />
                    </div>

                    <!-- MARCA -->
                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Marca
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Marca"
                                   maxlength="50"
                                   placeholder="Ej. Olympus" />
                    </div>

                    <!-- MODELO -->
                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Modelo
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Modelo"
                                   maxlength="50"
                                   placeholder="Ej. CX23" />
                    </div>

                    <!-- NÚMERO DE SERIE -->
                    <div class="col-md-6">
                        <label class="form-label fw-medium">
                            Número de serie
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.NumeroSerie"
                                   maxlength="100"
                                   placeholder="Número de serie del fabricante" />
                    </div>

                    <!-- UBICACIÓN -->
                    <div class="col-12">
                        <label class="form-label fw-medium">
                            Ubicación
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="modelo.Ubicacion"
                                   maxlength="100"
                                   placeholder="Ej. Laboratorio de Ciencias" />
                    </div>

                </div>

                <!-- ACCIONES -->
                <div class="border-top mt-4 pt-3 d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@enviando"
                            @onclick="LimpiarFormulario">

                        Limpiar
                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@enviando">

                        @if (enviando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Registrando...</span>
                        }
                        else
                        {
                            <i class="bi bi-save me-2"></i>
                            <span>Registrar equipo</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>
    </div>

</div>

@code {

    private RegistrarEquipoRequest modelo = new();

    private bool enviando = false;

    private bool hayError = false;

    private string? mensaje;

    private async Task RegistrarAsync()
    {
        if (enviando)
            return;

        enviando = true;
        hayError = false;
        mensaje = null;

        try
        {
            var codigo = modelo.Codigo;

            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            using var respuesta = await cliente.PostAsJsonAsync(
                "api/equipos",
                modelo
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                hayError = true;

                mensaje =
                    $"No se pudo procesar el equipo. Código HTTP: {(int)respuesta.StatusCode}.";

                return;
            }

            var contenido = await respuesta.Content
                .ReadAsStringAsync();

            using var documento = JsonDocument.Parse(contenido);

            var raiz = documento.RootElement;

            if (raiz.ValueKind == JsonValueKind.Object &&
                raiz.TryGetProperty("ok", out var ok) &&
                ok.ValueKind == JsonValueKind.True)
            {
                mensaje =
                    $"La API procesó el registro del equipo {codigo}. La inserción debe confirmarse en PostgreSQL.";

                modelo = new RegistrarEquipoRequest();
            }
            else
            {
                hayError = true;

                mensaje =
                    "La API no confirmó que la solicitud se procesara correctamente.";
            }
        }
        catch (HttpRequestException)
        {
            hayError = true;

            mensaje =
                "No se pudo establecer comunicación con la API.";
        }
        catch (TaskCanceledException)
        {
            hayError = true;

            mensaje =
                "La solicitud superó el tiempo de espera.";
        }
        catch (JsonException)
        {
            hayError = true;

            mensaje =
                "La API devolvió una respuesta que no se pudo interpretar.";
        }
        finally
        {
            enviando = false;
        }
    }

    private void LimpiarFormulario()
    {
        modelo = new RegistrarEquipoRequest();

        mensaje = null;

        hayError = false;
    }
}
