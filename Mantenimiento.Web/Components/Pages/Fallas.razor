@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@page "/fallas"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using Mantenimiento.Application.DTOs

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Fallas | Mantenimiento</PageTitle>

<div class="container-fluid py-3">

    <!-- =====================================
         1. ENCABEZADO
         ===================================== -->

    <div class="mb-4">

        <h2 class="fw-semibold mb-1">
            Gestión de fallas
        </h2>

        <p class="text-muted mb-0">
            Registro y seguimiento de incidencias en equipos de laboratorio
        </p>

    </div>

    <!-- =====================================
         2. TARJETA PRINCIPAL
         ===================================== -->

    <div class="card border">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2">

                <h5 class="fw-semibold mb-0">

                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Reportar falla

                </h5>

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        disabled="@cargandoEquipos"
                        @onclick="CargarEquiposAsync">

                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Actualizar equipos

                </button>

            </div>

        </div>

        <div class="card-body p-4">

            <!-- =====================================
                 3. MENSAJE DE RESPUESTA
                 ===================================== -->
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert @(hayError ? "alert-danger" : "alert-info")"
                     role="alert">

                    <i class="bi @(hayError ? "bi-exclamation-circle" : "bi-info-circle") me-2"></i>

                    @mensaje

                </div>
            }

            <!-- =====================================
                 4. FORMULARIO
                 ===================================== -->

            <EditForm Model="@modelo"
                      OnValidSubmit="ReportarAsync"
                      FormName="reporte-falla">

                <DataAnnotationsValidator />

                <div class="row g-3">

                    <!-- SELECCIONAR EQUIPO -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Equipo *
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="modelo.IdEquipo"
                                     disabled="@cargandoEquipos">

                            <option value="0">
                                -- Seleccione un equipo --
                            </option>

                            @foreach (var equipo in equipos)
                            {
                                <option value="@equipo.IdEquipo">
                                    @equipo.Codigo - @equipo.Nombre
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.IdEquipo)"
                                           class="text-danger small" />

                        @if (cargandoEquipos)
                        {
                            <div class="form-text">
                                Cargando equipos...
                            </div>
                        }
                        else
                        {
                            <div class="form-text">
                                Seleccione el equipo que presenta la falla.
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(errorEquipos))
                        {
                            <div class="text-danger small mt-1">
                                @errorEquipos
                            </div>
                        }

                    </div>

                    <!-- PRIORIDAD -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Prioridad *
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="modelo.Prioridad">

                            <option value="Baja">
                                Baja
                            </option>

                            <option value="Media">
                                Media
                            </option>

                            <option value="Alta">
                                Alta
                            </option>

                        </InputSelect>

                        <ValidationMessage For="@(() => modelo.Prioridad)"
                                           class="text-danger small" />

                        <div class="form-text">
                            Seleccione el nivel de prioridad.
                        </div>

                    </div>

                    <!-- DESCRIPCIÓN -->

                    <div class="col-12">

                        <label class="form-label">
                            Descripción de la falla *
                        </label>

                        <InputTextArea class="form-control"
                                       @bind-Value="modelo.Descripcion"
                                       rows="4"
                                       placeholder="Describa el problema que presenta el equipo..." />

                        <ValidationMessage For="@(() => modelo.Descripcion)"
                                           class="text-danger small" />

                        <div class="form-text">
                            Describa los síntomas y detalles que faciliten
                            el diagnóstico del equipo.
                        </div>

                    </div>

                </div>

                <!-- =====================================
                     5. BOTONES
                     ===================================== -->

                <div class="border-top mt-4 pt-3
                    d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@enviando"
                            @onclick="LimpiarFormulario">

                        Limpiar

                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@(enviando || cargandoEquipos || equipos.Count == 0)">

                        @if (enviando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>

                            <span>Enviando reporte...</span>
                        }
                        else
                        {
                            <i class="bi bi-send me-2"></i>

                            <span>Reportar falla</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>

    </div>

</div>

@code {

    // ==========================================
    // 1. MODELO DEL FORMULARIO
    // ==========================================

    private ReportarFallaRequest modelo = new();

    private bool enviando = false;

    private bool hayError = false;

    private string? mensaje;


    // ==========================================
    // 2. MODELO PARA MOSTRAR EQUIPOS
    // ==========================================

    private sealed class EquipoOpcion
    {
        public int IdEquipo { get; set; }

        public string Codigo { get; set; } = string.Empty;

        public string Nombre { get; set; } = string.Empty;
    }


    // ==========================================
    // 3. VARIABLES DEL SELECTOR
    // ==========================================

    private List<EquipoOpcion> equipos = new();

    private bool cargandoEquipos = false;

    private string? errorEquipos;


    // ==========================================
    // 4. CARGAR EQUIPOS AL INICIAR
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        await CargarEquiposAsync();
    }


    // ==========================================
    // 5. CONSULTAR EQUIPOS DESDE WF06
    // ==========================================

    private async Task CargarEquiposAsync()
    {
        if (cargandoEquipos)
            return;

        cargandoEquipos = true;
        errorEquipos = null;

        try
        {
            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            using var respuesta = await cliente.GetAsync(
                "api/reportes/mantenimientos"
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                errorEquipos =
                    $"No se pudieron consultar los equipos. HTTP {(int)respuesta.StatusCode}.";

                return;
            }

            var contenido = await respuesta.Content
                .ReadAsStringAsync();

            using var documento = JsonDocument.Parse(
                contenido
            );

            var registros = BuscarRegistros(
                documento.RootElement
            );

            if (!registros.HasValue)
            {
                errorEquipos =
                    "No se encontró una lista de equipos en el reporte.";

                return;
            }

            var lista = new List<EquipoOpcion>();

            foreach (var registro in registros.Value.EnumerateArray())
            {
                if (registro.ValueKind != JsonValueKind.Object)
                    continue;

                // ID del equipo
                if (!registro.TryGetProperty(
                    "id_equipo", out var id))
                    continue;

                // Código del equipo
                if (!registro.TryGetProperty(
                    "codigo", out var codigo))
                    continue;

                // Nombre del equipo
                if (!registro.TryGetProperty(
                    "nombre", out var nombre))
                    continue;

                int idEquipo;

                if (id.ValueKind == JsonValueKind.Number)
                {
                    if (!id.TryGetInt32(out idEquipo))
                        continue;
                }
                else if (!int.TryParse(
                    id.ToString(), out idEquipo))
                {
                    continue;
                }

                if (idEquipo <= 0)
                    continue;

                lista.Add(new EquipoOpcion
                {
                    IdEquipo = idEquipo,
                    Codigo = codigo.ToString(),
                    Nombre = nombre.ToString()
                });
            }

            // Eliminar duplicados y ordenar
            equipos = lista
                .DistinctBy(e => e.IdEquipo)
                .OrderBy(e => e.Nombre)
                .ThenBy(e => e.Codigo)
                .ToList();

            if (equipos.Count == 0)
            {
                errorEquipos =
                    "No se encontraron equipos para seleccionar.";
            }

            // Mantener selección solamente si existe
            if (!equipos.Any(
                e => e.IdEquipo == modelo.IdEquipo))
            {
                modelo.IdEquipo = 0;
            }
        }
        catch (HttpRequestException)
        {
            errorEquipos =
                "No fue posible conectar con la API de mantenimiento.";
        }
        catch (JsonException)
        {
            errorEquipos =
                "La API devolvió un reporte JSON inválido.";
        }
        catch (TaskCanceledException)
        {
            errorEquipos =
                "La consulta de equipos superó el tiempo de espera.";
        }
        finally
        {
            cargandoEquipos = false;
        }
    }


    // ==========================================
    // 6. BUSCAR LOS REGISTROS DENTRO DEL JSON
    // ==========================================

    private static JsonElement? BuscarRegistros(
        JsonElement elemento,
        int nivel = 0)
    {
        if (nivel > 5)
            return null;

        if (elemento.ValueKind == JsonValueKind.Array)
            return elemento;

        if (elemento.ValueKind != JsonValueKind.Object)
            return null;

        // Buscar dentro de las propiedades del reporte
        foreach (var propiedad in elemento.EnumerateObject())
        {
            var resultado = BuscarRegistros(
                propiedad.Value,
                nivel + 1
            );

            if (resultado.HasValue)
                return resultado;
        }

        return null;
    }


    // ==========================================
    // 7. REPORTAR FALLA MEDIANTE WF02
    // ==========================================

    private async Task ReportarAsync()
    {
        if (enviando)
            return;

        enviando = true;
        hayError = false;
        mensaje = null;

        try
        {
            int idEquipo = modelo.IdEquipo;

            // Verificar selección real
            if (!equipos.Any(e => e.IdEquipo == idEquipo))
            {
                hayError = true;
                mensaje = "Seleccione un equipo válido.";
                return;
            }

            var cliente = HttpClientFactory.CreateClient(
                "MantenimientoApi"
            );

            using var respuesta = await cliente.PostAsJsonAsync(
                "api/fallas",
                modelo
            );

            if (!respuesta.IsSuccessStatusCode)
            {
                hayError = true;

                mensaje =
                    $"No fue posible procesar la falla. HTTP {(int)respuesta.StatusCode}.";

                return;
            }

            var contenido = await respuesta.Content
                .ReadAsStringAsync();

            using var documento = JsonDocument.Parse(
                contenido
            );

            var raiz = documento.RootElement;

            // Confirmación de procesamiento desde API
            if (raiz.ValueKind == JsonValueKind.Object &&
                raiz.TryGetProperty("ok", out var ok) &&
                ok.ValueKind == JsonValueKind.True)
            {
                mensaje =
                    $"La API procesó el reporte del equipo {idEquipo}. " +
                    "Verifique que la falla se haya registrado en PostgreSQL.";

                modelo = new ReportarFallaRequest();
            }
            else
            {
                hayError = true;

                mensaje =
                    "La API no confirmó el procesamiento del reporte.";
            }
        }
        catch (HttpRequestException)
        {
            hayError = true;

            mensaje =
                "No se pudo establecer comunicación con la API.";
        }
        catch (TaskCanceledException)
        {
            hayError = true;

            mensaje =
                "La solicitud superó el tiempo de espera.";
        }
        catch (JsonException)
        {
            hayError = true;

            mensaje =
                "La API devolvió una respuesta que no se pudo interpretar.";
        }
        finally
        {
            enviando = false;
        }
    }


    // ==========================================
    // 8. LIMPIAR FORMULARIO
    // ==========================================

    private void LimpiarFormulario()
    {
        modelo = new ReportarFallaRequest();

        mensaje = null;

        hayError = false;
    }
}
