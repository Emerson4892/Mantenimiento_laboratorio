    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.id_falla,\n    f.id_equipo,\n    e.codigo,\n    e.nombre AS equipo,\n    f.descripcion,\n    f.prioridad,\n    f.estado,\n    f.fecha_reporte\nFROM fallas f\nINNER JOIN equipos e\n    ON f.id_equipo = e.id_equipo\nWHERE f.estado = 'Pendiente'\n  AND f.prioridad = 'Alta'\n  AND NOT EXISTS (\n      SELECT 1\n      FROM alertas a\n      WHERE a.id_falla = f.id_falla\n  )\nORDER BY f.fecha_reporte ASC;",
        "options": {}
      },
