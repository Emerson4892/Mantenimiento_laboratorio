      "parameters": {
        "jsCode": "const datos = $json.body ?? $json;\n\nconst errores = [];\n\nif (!datos.codigo || String(datos.codigo).trim() === \"\") {\n    errores.push(\"Falta el código\");\n}\n\nif (!datos.nombre || String(datos.nombre).trim() === \"\") {\n    errores.push(\"Falta el nombre\");\n}\n\nif (!datos.tipo || String(datos.tipo).trim() === \"\") {\n    errores.push(\"Falta el tipo\");\n}\n\nreturn [{\n    json: {\n        ...datos,\n        codigo: datos.codigo?.trim(),\n        nombre: datos.nombre?.trim(),\n        tipo: datos.tipo?.trim(),\n        valido: errores.length === 0,\n        errores\n    }\n}];;"
      },
