        "jsCode": "const datos = $json.body ?? $json;\nconst errores = [];\n\nif (!datos.id_mantenimiento) {\n    errores.push(\"Falta el ID del mantenimiento\");\n}\n\nif (!datos.solucion) {\n    errores.push(\"Falta la solución realizada\");\n}\n\nreturn [{\n    json: {\n        ...datos,\n        valido: errores.length === 0,\n        errores\n    }\n}];"
      },
