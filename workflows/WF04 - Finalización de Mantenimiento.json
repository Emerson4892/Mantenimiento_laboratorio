    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    EXISTS(\n        SELECT 1\n        FROM mantenimientos\n        WHERE id_mantenimiento = $1\n    ) AS existe,\n    (\n        SELECT m.id_mantenimiento\n        FROM mantenimientos m\n        WHERE m.id_mantenimiento = $1\n        LIMIT 1\n    ) AS id_mantenimiento,\n    (\n        SELECT m.id_falla\n        FROM mantenimientos m\n        WHERE m.id_mantenimiento = $1\n        LIMIT 1\n    ) AS id_falla,\n    (\n        SELECT f.id_equipo\n        FROM mantenimientos m\n        JOIN fallas f ON f.id_falla = m.id_falla\n        WHERE m.id_mantenimiento = $1\n        LIMIT 1\n    ) AS id_equipo,\n    (\n        SELECT m.estado\n        FROM mantenimientos m\n        WHERE m.id_mantenimiento = $1\n        LIMIT 1\n    ) AS estado_mantenimiento;",
        "options": {
          "queryReplacement": "={{ [$json.id_mantenimiento] }}"
        }
      },
