      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    EXISTS(\n        SELECT 1\n        FROM fallas\n        WHERE id_falla = $1\n    ) AS existe,\n    (\n        SELECT id_falla\n        FROM fallas\n        WHERE id_falla = $1\n        LIMIT 1\n    ) AS id_falla,\n    (\n        SELECT id_equipo\n        FROM fallas\n        WHERE id_falla = $1\n        LIMIT 1\n    ) AS id_equipo,\n    (\n        SELECT estado\n        FROM fallas\n        WHERE id_falla = $1\n        LIMIT 1\n    ) AS estado_falla;",
        "options": {
