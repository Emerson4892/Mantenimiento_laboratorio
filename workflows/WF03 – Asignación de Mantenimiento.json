    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH nuevo AS (\n    INSERT INTO mantenimientos (\n        id_falla,\n        tecnico,\n        observacion,\n        estado\n    )\n    SELECT\n        f.id_falla,\n        $2::text,\n        NULLIF($3::text, ''),\n        'Asignado'\n    FROM fallas f\n    WHERE f.id_falla = $1::integer\n      AND f.estado = 'Pendiente'\n      AND NOT EXISTS (\n          SELECT 1\n          FROM mantenimientos m\n          WHERE m.id_falla = f.id_falla\n            AND m.estado IN ('Asignado', 'En proceso')\n      )\n    ON CONFLICT (id_falla)\n    WHERE estado IN ('Asignado', 'En proceso')\n    DO NOTHING\n    RETURNING id_mantenimiento\n)\nSELECT\n    EXISTS (SELECT 1 FROM nuevo) AS ok,\n    (SELECT id_mantenimiento FROM nuevo) AS id_mantenimiento,\n    CASE\n        WHEN EXISTS (SELECT 1 FROM nuevo)\n        THEN 'Mantenimiento asignado correctamente'\n        ELSE 'La falla no está pendiente o ya tiene un mantenimiento activo'\n    END AS mensaje;\n",
        "options": {
          "queryReplacement": "={{ [\n  $(\"Validar datos de asignación\").first().json.id_falla,\n  $(\"Validar datos de asignación\").first().json.tecnico,\n  $(\"Validar datos de asignación\").first().json.observacion ?? null\n] }}"
        }
      },
