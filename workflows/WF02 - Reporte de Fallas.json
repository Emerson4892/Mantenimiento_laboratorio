    {
      "parameters": {
        "jsCode": "\nconst datos = $input.first().json.body ?? {};\n\nconst errores = [];\n\nconst idEquipo = Number(datos.id_equipo);\n\n// Validar identificador del equipo\nif (!Number.isInteger(idEquipo) || idEquipo <= 0) {\n  errores.push(\"El ID del equipo es obligatorio y debe ser válido\");\n}\n\n// Validar descripción\nif (\n  typeof datos.descripcion !== \"string\" ||\n  datos.descripcion.trim() === \"\"\n) {\n  errores.push(\"Falta la descripción de la falla\");\n}\n\n// Validar prioridad\nconst prioridadesValidas = [\"Baja\", \"Media\", \"Alta\"];\n\nconst prioridad = datos.prioridad || \"Media\";\n\nif (!prioridadesValidas.includes(prioridad)) {\n  errores.push(\"La prioridad no es válida\");\n}\n\nreturn [\n  {\n    json: {\n      id_equipo: idEquipo,\n      descripcion: datos.descripcion,\n      prioridad: prioridad,\n      valido: errores.length === 0,\n      errores: errores\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        0
      ],
      "id": "bb1a9d85-2820-4ca1-bc3b-e54c93f6c620",
